NODE_ENV=production
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=1

# TiDB Cloud / TiDB MySQL
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your-tidb-username
DB_PASSWORD=your-tidb-password
DB_DATABASE=vexatrade
DB_CONNECTION_LIMIT=10
TIDB_SSL=true

REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=vexatrade:

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

SESSION_SECRET=replace-with-a-long-random-session-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGIN=https://your-user-frontend.example,https://your-admin-frontend.example

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100

# Cloudinary: persistent KYC document storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

CERTIFICATE_ISSUER=VexaTrade Blockchain Ecosystem
CERTIFICATE_VALIDITY_DAYS=365
CERTIFICATE_VERIFY_BASE_URL=https://your-backend.example/api/certificates/verify

EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_API_URL=
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_NETWORK=mainnet
BLOCKCHAIN_CONTRACT_ADDRESS=

VEXA_ACCOUNT_SSO_ENABLED=false
VEXA_ACCOUNT_SSO_URL=
VEXA_ACCOUNT_SSO_CLIENT_ID=
VEXA_ACCOUNT_SSO_CLIENT_SECRET=

ADMIN_EMAIL=admin@vexatrade.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=VexaTrade Administrator

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is temporarily under maintenance.
